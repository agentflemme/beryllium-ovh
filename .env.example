# --- Beszel (hub) -------------------------------------------------------------
BESZEL_URL=http://127.0.0.1:8090
BESZEL_EMAIL=admin@example.com
BESZEL_PASSWORD=change-me
# Note: Beszel password auth uses a 20 s timeout (slow bcrypt) and the access
# token is cached ~18 min so re-auth is not required on every poll.

# --- UptimeRobot (telemetry source) -------------------------------------------
# POST https://api.uptimerobot.com/v2/getMonitors with form body api_key=...
# Enable by setting UPTIMEROBOT_API_KEY; unset → silently skipped.
UPTIMEROBOT_API_KEY=

# --- Server (adapter-node) ----------------------------------------------------
PORT=3000
HOST=0.0.0.0
